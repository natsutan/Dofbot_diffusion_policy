#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "dofbot_urdf"
    doc = """Generated from Composed Stage of root layer /tmp/tmpktnag_id/dofbot_urdf.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_dofbot_e5mwbzeq/usdex_dofbot/dofbot_urdf.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_dofbot_e5mwbzeq/temp_dofbot/dofbot.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "dofbot_urdf" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </dofbot_urdf/Physics/arm5_Joint>,
        </dofbot_urdf/Physics/Rlink1_Joint>,
        </dofbot_urdf/Physics/Llink1_Joint>,
        </dofbot_urdf/Physics/Rlink3_Joint>,
        </dofbot_urdf/Physics/Llink3_Joint>,
        </dofbot_urdf/Physics/Gripping_Joint>,
        </dofbot_urdf/Physics/arm4_Joint>,
        </dofbot_urdf/Physics/Camera_Joint>,
        </dofbot_urdf/Physics/arm3_Joint>,
        </dofbot_urdf/Physics/arm2_Joint>,
        </dofbot_urdf/Physics/arm1_Joint>,
        </dofbot_urdf/Physics/root_joint>,
        </dofbot_urdf/Physics/Rlink2_Joint>,
        </dofbot_urdf/Physics/Llink2_Joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link/arm3_Link/arm4_Link/arm5_Link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link/arm3_Link/arm4_Link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link/arm3_Link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link>,
        </dofbot_urdf/Geometry/base_link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link/arm3_Link/arm4_Link/Camera_Link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link/arm3_Link/arm4_Link/arm5_Link/Rlink1_Link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link/arm3_Link/arm4_Link/arm5_Link/Rlink1_Link/Rlink2_Link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link/arm3_Link/arm4_Link/arm5_Link/Llink1_Link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link/arm3_Link/arm4_Link/arm5_Link/Llink1_Link/Llink2_Link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link/arm3_Link/arm4_Link/arm5_Link/Rlink3_Link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link/arm3_Link/arm4_Link/arm5_Link/Llink3_Link>,
        </dofbot_urdf/Geometry/base_link/arm1_Link/arm2_Link/arm3_Link/arm4_Link/arm5_Link/Gripping_point_Link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "arm1_Link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "arm2_Link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "arm3_Link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "arm4_Link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "arm5_Link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "Rlink1_Link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "Rlink2_Link" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                    }
                                }

                                over "Llink1_Link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "Llink2_Link" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                    }
                                }

                                over "Rlink3_Link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }

                                over "Llink3_Link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }

                                over "Gripping_point_Link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }

                            over "Camera_Link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "arm1_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "arm2_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "arm3_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "arm4_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "arm5_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Rlink1_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Rlink2_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Llink1_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Llink2_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Rlink3_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Llink3_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Camera_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Gripping_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

